---
import { sanityClient, urlFor } from '../lib/sanityClient';
import { HOME_PAGE_QUERY, SITE_SETTINGS_QUERY } from '../lib/queries';

const { page, posts } = await sanityClient.fetch(HOME_PAGE_QUERY, {
  postCount: 2,
});
const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

// Fallbacks so the page still renders sensibly before Site Settings is filled in.
const navLinks = settings?.navLinks?.length
  ? settings.navLinks
  : [
      { label: 'Work', anchor: '#work' },
      { label: 'Process', anchor: '#process' },
      { label: 'About', anchor: '#about' },
      { label: 'Blog', anchor: '#blog' },
    ];
const navCta = settings?.navCta ?? {
  label: 'Chat with Mickey',
  url: 'https://calendly.com/mickeybowen/30min',
  openInNewTab: true,
};
const footerText = settings?.footerText ?? '© 2026 Mickey Bowen';
const socialLinks = settings?.socialLinks ?? [];

const rating = page?.socialProofRating ?? 4.5;
const fullStars = Math.round(rating);
---
<style>
  :root {
    --ink: #0B1220;
    --ink-soft: #5B6472;
    --ink-faint: #94A3B8;
    --blue: #2A5BFF;
    --blue-dark: #1C3FCC;
    --line: #E7EAF0;
    --panel: #F5F7FA;
    --card: #F1F4F8;
    --swatch: #EEF1F6;
    --stone: #B9C2CF;
    --paper-bg: #FFFFFF;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--paper-bg);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 32px; }
  h1, h2 { font-family: 'Inter', sans-serif; font-weight: 700; letter-spacing: -0.02em; }
  a { color: inherit; text-decoration: none; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; color: var(--blue); font-weight: 600; margin: 0 0 18px;
  }
  .eyebrow.center { justify-content: center; width: 100%; }
  .eyebrow .mark { width: 14px; height: 14px; flex-shrink: 0; }
  section { scroll-margin-top: 24px; }

  .nav-bar { background: #FAF9F6; border-bottom: 1px solid var(--line); }
  nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 26px 32px; max-width: 1080px; margin: 0 auto; box-sizing: border-box;
  }
  nav .logo { font-size: 19px; font-weight: 700; letter-spacing: -0.01em; }
  .nav-cta { display: flex; align-items: center; gap: 10px; }
  .nav-avatar {
    width: 32px; height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--panel); display: flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 2px #FFFFFF;
  }
  .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .cta-short { display: none; }
  nav .links { display: flex; gap: 34px; font-size: 15px; color: var(--ink-soft); font-weight: 500; }
  nav .links a:hover { color: var(--ink); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border: none; border-radius: 999px; font-size: 15px; font-weight: 600;
    cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .btn:hover { opacity: 0.9; }
  .btn-primary { background: var(--blue); color: #FFFFFF; height: 48px; padding: 0 26px; }
  .btn-secondary { background: transparent; color: var(--ink); border: 1.5px solid var(--line); height: 48px; padding: 0 26px; }
  .btn-link { font-size: 15px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; display: inline-flex; align-items: center; gap: 6px; }
  nav .btn-primary { height: 40px; padding: 0 20px; font-size: 14px; border-radius: 999px; }

  #hero {
    padding: 56px 32px 72px; display: grid; grid-template-columns: 1fr 0.8fr;
    gap: 56px; align-items: center; max-width: 1080px; margin: 0 auto; box-sizing: border-box;
  }
  #hero h1 { font-size: clamp(34px, 4.4vw, 52px); line-height: 1.08; margin: 0 0 22px; max-width: 600px; }
  #hero p.lede { font-size: 17px; color: var(--ink-soft); line-height: 1.65; margin: 0 0 32px; max-width: 460px; font-weight: 400; }
  .btn-row { display: flex; gap: 14px; margin-bottom: 24px; flex-wrap: wrap; }
  .reassure { display: flex; gap: 22px; flex-wrap: wrap; }
  .reassure-item { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-soft); font-weight: 500; }
  .reassure-item svg { flex-shrink: 0; }

  .hero-carousel { position: relative; height: 380px; display: flex; justify-content: center; }
  .ctrack { position: relative; width: 100%; height: 100%; }
  .citem {
    position: absolute; top: 0; left: 50%; width: 190px;
    transition: transform 0.7s cubic-bezier(0.65,0,0.35,1), opacity 0.7s ease;
  }
  .citem.pos-center { transform: translateX(-50%) scale(1); z-index: 3; opacity: 1; }
  .citem.pos-left { transform: translateX(calc(-50% - 132px)) scale(0.74); z-index: 1; opacity: 0.45; }
  .citem.pos-right { transform: translateX(calc(-50% + 132px)) scale(0.74); z-index: 1; opacity: 0.45; }
  .ccard {
    background: #FFFFFF; border: 1px solid var(--line); border-radius: 16px;
    box-shadow: 0 16px 40px rgba(15,23,42,0.10); overflow: hidden; height: 250px;
    display: flex; flex-direction: column; position: relative;
  }
  .citem.pos-center .ccard { box-shadow: 0 24px 54px rgba(15,23,42,0.16); }
  .clabel { text-align: center; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin: 14px 0 0; }
  .citem.pos-center .clabel { color: var(--ink); }

  .cnav { display: flex; align-items: center; gap: 5px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .cnav .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--stone); }
  .cnav .bar { height: 6px; border-radius: 3px; background: var(--swatch); }
  .cnav .bar.a { width: 22px; }
  .cnav .bar.b { width: 16px; }

  .whero { margin: 12px; height: 70px; border-radius: 8px; background: var(--swatch); }
  .wline { height: 8px; border-radius: 4px; background: var(--swatch); margin: 0 12px 8px; }
  .wline.short { width: 55%; }
  .wcta { width: 72px; height: 22px; border-radius: 6px; background: var(--swatch); margin: 10px 12px 0; }

  .dhero { margin: 12px; height: 70px; border-radius: 8px; background: linear-gradient(135deg, var(--blue), #6E8CFF); }
  .dline { height: 8px; border-radius: 4px; background: var(--ink); opacity: 0.85; margin: 0 12px 8px; }
  .dline.short { width: 50%; opacity: 0.4; }
  .dcta { width: 76px; height: 24px; border-radius: 999px; background: var(--blue); margin: 10px 12px 0; }
  .fig-badge {
    position: absolute; top: 10px; right: 10px; display: flex; align-items: center; gap: 4px;
    background: #FFFFFF; border: 1px solid var(--line); border-radius: 999px; padding: 3px 8px 3px 5px;
    box-shadow: 0 4px 10px rgba(15,23,42,0.08);
  }
  .fig-badge svg { display: block; }
  .fig-badge span { font-size: 9.5px; font-weight: 600; color: var(--ink-soft); }

  .laptop { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--panel); padding: 16px 0 0; }
  .lscreen { width: 84%; border-radius: 6px 6px 0 0; border: 5px solid var(--ink); border-bottom: none; overflow: hidden; background: #FFFFFF; }
  .lscreen-inner { padding: 6px; }
  .lbase { width: 96%; height: 8px; background: var(--ink); border-radius: 0 0 4px 4px; margin-top: -1px; }

  #logos { padding: 64px 0 56px; border-top: 1px solid var(--line); }
  .logo-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; align-items: center; margin-top: 12px; }
  .logo-slot { height: 32px; }
  .logo-slot img { filter: invert(1) grayscale(1); opacity: 0.55; }

  #testimonials-top { padding: 0 0 64px; }
  .testi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .testi-card { border: 1px solid var(--line); border-radius: 16px; padding: 28px; background: var(--paper-bg); }
  .testi-card p.quote { font-size: 16px; line-height: 1.6; margin: 0 0 18px; font-weight: 500; }
  .testi-who { display: flex; align-items: center; gap: 12px; }
  .avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--swatch); flex-shrink: 0; }
  .testi-who span { font-size: 13px; color: var(--ink-soft); }

  #problem { padding: 72px 0; border-top: 1px solid var(--line); }
  #problem h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.2; margin: 0 0 18px; max-width: 580px; }
  #problem p.body { font-size: 16px; color: var(--ink-soft); line-height: 1.7; margin: 0 0 32px; max-width: 580px; }
  .pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .pain-item span { display: block; font-size: 14px; color: var(--ink); margin-top: 12px; font-weight: 500; }

  #solution { padding: 72px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--panel); }
  #solution h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.2; margin: 0 0 16px; max-width: 580px; }
  #solution p.body { font-size: 18px; color: var(--ink); line-height: 1.6; margin: 0 0 28px; max-width: 580px; font-weight: 500; }

  #process { padding: 72px 0; border-bottom: 1px solid var(--line); }
  #process h2 { font-size: clamp(24px, 2.6vw, 32px); margin: 0 0 34px; max-width: 580px; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .steps .num { font-size: 15px; color: var(--blue); font-weight: 700; margin: 0 0 10px; }
  .steps .name { font-size: 15px; margin: 0; font-weight: 500; }

  #pricing { padding: 72px 0; border-bottom: 1px solid var(--line); background: var(--panel); }
  #pricing h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.2; margin: 0 0 16px; max-width: 580px; }
  #pricing p.body { font-size: 16px; color: var(--ink-soft); line-height: 1.7; margin: 0 0 40px; max-width: 580px; }
  .pricing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
  .price-card { background: #FFFFFF; border: 1px solid var(--line); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; }
  .price-card.featured { border: 1.5px solid var(--blue); box-shadow: 0 4px 24px rgba(42,91,255,0.08); position: relative; }
  .price-badge { position: absolute; top: -12px; left: 28px; background: var(--blue); color: #FFFFFF; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 999px; letter-spacing: 0.02em; }
  .price-card h3 { font-size: 20px; font-weight: 700; margin: 0 0 4px; }
  .price-card .price-tag { font-size: 38px; font-weight: 800; letter-spacing: -0.02em; margin: 14px 0 2px; }
  .price-card .price-sub { font-size: 13px; color: var(--ink-soft); margin: 0 0 20px; }
  .price-card .price-desc { font-size: 14.5px; color: var(--ink-soft); line-height: 1.65; margin: 0 0 22px; }
  .price-list { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .price-list li { display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 500; }
  .price-card .btn { margin-top: auto; width: 100%; justify-content: center; }

  #about { padding: 72px 0; border-bottom: 1px solid var(--line); }
  .about-grid { display: grid; grid-template-columns: 0.55fr 1fr; gap: 48px; align-items: center; }
  .about-photo { width: 100%; max-width: 320px; aspect-ratio: 1/1; border-radius: 50%; background: var(--panel); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }
  #about h2 { font-size: clamp(22px, 2.4vw, 28px); margin: 0 0 22px; }
  .about-list { display: flex; flex-direction: column; gap: 14px; }
  .about-item { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; }

  #work { padding: 72px 0; border-bottom: 1px solid var(--line); }
  .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .work-tile { background: var(--card); border-radius: 16px; aspect-ratio: 4/3; display: flex; align-items: flex-end; padding: 20px; }
  .work-tile span { font-size: 14px; font-weight: 600; }

  #faq { padding: 72px 0; border-bottom: 1px solid var(--line); }
  .faq-list { max-width: 640px; }
  .faq-item { border-bottom: 1px solid var(--line); padding-bottom: 24px; margin-bottom: 24px; }
  .faq-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .faq-item .q { font-size: 16px; font-weight: 600; margin: 0 0 10px; }
  .faq-item .a { font-size: 14.5px; color: var(--ink-soft); line-height: 1.65; margin: 0; }

  #final-testimonial { padding: 72px 0 0; }
  .final-testi { border: 1px solid var(--line); border-radius: 16px; padding: 36px; max-width: 560px; margin: 0 auto; text-align: center; }
  .final-testi p.quote { font-size: 19px; line-height: 1.55; margin: 0 0 14px; font-weight: 500; }
  .final-testi p.who { font-size: 13px; color: var(--ink-soft); margin: 0; }

  #contact { padding: 64px 0 8px; text-align: center; }
  #contact h2 { font-size: clamp(24px, 2.8vw, 32px); margin: 0 0 14px; }
  #contact p.sub { font-size: 15px; color: var(--ink-soft); margin: 0 0 26px; }

  #social-proof { padding: 18px 0 64px; text-align: center; }
  .stars { display: flex; justify-content: center; gap: 3px; margin-bottom: 8px; }
  #social-proof p { font-size: 13px; color: var(--ink-soft); margin: 0; }

  #blog { padding: 72px 0; border-top: 1px solid var(--line); }
  .blog-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
  .blog-head a { font-size: 14px; color: var(--blue); font-weight: 600; }
  .blog-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .blog-thumb { background: var(--card); border-radius: 16px; aspect-ratio: 16/9; margin-bottom: 14px; }
  .blog-grid h3 { font-size: 15px; font-weight: 600; margin: 0 0 5px; }
  .blog-grid time { font-size: 12.5px; color: var(--ink-faint); }

  footer {
    border-top: 1px solid var(--line); padding: 28px 32px; display: flex;
    justify-content: space-between; font-size: 13px; color: var(--ink-faint);
    max-width: 1080px; margin: 0 auto; box-sizing: border-box;
  }

  @media (max-width: 900px) {
    #hero { grid-template-columns: 1fr; padding-top: 40px; }
    .hero-photo { order: -1; margin-bottom: 8px; }
    .hero-photo-frame { max-width: 240px; }
    .testi-grid, .work-grid, .blog-grid, .pricing-grid { grid-template-columns: 1fr; }
    .pain-grid, .steps, .logo-grid { grid-template-columns: repeat(2, 1fr); }
    .about-grid { grid-template-columns: 1fr; text-align: left; }
    .about-photo { margin: 0 0 16px; max-width: 200px; }
    nav .links { display: none; }
  }
  @media (max-width: 560px) {
    .wrap { padding-left: 20px; padding-right: 20px; }
    #hero, nav, footer { padding-left: 20px; padding-right: 20px; }
    .cta-full { display: none; }
    .cta-short { display: inline; }
    .pain-grid, .steps, .logo-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .btn-row { flex-direction: column; align-items: stretch; }
    .btn-row .btn { width: 100%; }
    .reassure { flex-direction: column; gap: 10px; }
    .float-card { max-width: 260px; }
  }
</style>
<div class="nav-bar">
<nav>
  <span class="logo">{settings?.siteName ?? 'Mickey Bowen'}</span>
  <div class="links">
    {navLinks.map((link) => (
      <a href={link.anchor}>{link.label}</a>
    ))}
  </div>
  <div class="nav-cta">
    <span class="nav-avatar">
      <img
        src={settings?.navAvatar ? urlFor(settings.navAvatar).width(72).height(72).url() : '/images/mickey-headshot.jpg'}
        alt={settings?.siteName ?? 'Mickey Bowen'}
      />
    </span>
    <a
      href={navCta.url}
      target={navCta.openInNewTab ? '_blank' : undefined}
      rel={navCta.openInNewTab ? 'noopener' : undefined}
      class="btn btn-primary nav-btn"
    >
      {navCta.label}
    </a>
  </div>
</nav>
</div>

<section id="hero">
  <div>
    <p class="eyebrow">
      <svg class="mark" viewBox="0 0 24 24" fill="#2A5BFF"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>
      {page?.heroPreHeadline}
    </p>
    <h1>{page?.heroHeadline}</h1>
    <p class="lede">{page?.heroSubtext}</p>
    <div class="btn-row">
      {page?.heroPrimaryCta && (
        <a
          href={page.heroPrimaryCta.url}
          target={page.heroPrimaryCta.openInNewTab ? '_blank' : undefined}
          rel={page.heroPrimaryCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-primary"
        >
          {page.heroPrimaryCta.label}
        </a>
      )}
      {page?.heroSecondaryCta && (
        <a
          href={page.heroSecondaryCta.url}
          target={page.heroSecondaryCta.openInNewTab ? '_blank' : undefined}
          rel={page.heroSecondaryCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-secondary"
        >
          {page.heroSecondaryCta.label}
        </a>
      )}
    </div>
    <div class="reassure">
      {(page?.heroReassurance ?? []).map((item) => (
        <div class="reassure-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2A5BFF" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
          {item}
        </div>
      ))}
    </div>
  </div>
  <div class="hero-carousel">
    <div class="ctrack">

      <div class="citem" data-key="strategy">
        <div class="ccard">
          <div class="cnav"><div class="dot"></div><div class="bar a"></div><div class="bar b"></div></div>
          <div class="whero"></div>
          <div class="wline"></div>
          <div class="wline short"></div>
          <div class="wcta"></div>
        </div>
        <p class="clabel">Strategy</p>
      </div>

      <div class="citem" data-key="design">
        <div class="ccard">
          <div class="fig-badge">
            <svg width="11" height="11" viewBox="0 0 24 24"><circle cx="8" cy="8" r="5" fill="#2A5BFF"/><circle cx="16" cy="16" r="5" fill="#6E8CFF" opacity="0.85"/></svg>
            <span>Figma</span>
          </div>
          <div class="cnav"><div class="dot"></div><div class="bar a"></div><div class="bar b"></div></div>
          <div class="dhero"></div>
          <div class="dline"></div>
          <div class="dline short"></div>
          <div class="dcta"></div>
        </div>
        <p class="clabel">Design</p>
      </div>

      <div class="citem" data-key="deploy">
        <div class="ccard">
          <div class="laptop">
            <div class="lscreen">
              <div class="lscreen-inner">
                <div class="cnav" style="padding:5px 6px;"><div class="dot"></div><div class="bar a" style="width:14px;"></div></div>
                <div class="dhero" style="height:34px; margin:6px;"></div>
                <div class="dline" style="margin:0 6px 4px; height:5px;"></div>
              </div>
            </div>
            <div class="lbase"></div>
          </div>
        </div>
        <p class="clabel">Deploy</p>
      </div>

    </div>
  </div>
</section>

<section id="logos">
  <div class="wrap">
    <p class="eyebrow center" style="color:var(--ink-soft); font-weight:600;">{page?.logoCloudHeading}</p>
    <div class="logo-grid">
      {(page?.logos?.length ? page.logos : [null, null, null, null, null]).map((logo) => (
        <div class="logo-slot">
          {logo && <img src={urlFor(logo).height(40).url()} alt="" style="max-height:40px;" />}
        </div>
      ))}
    </div>
  </div>
</section>

<section id="testimonials-top">
  <div class="wrap">
    <div class="testi-grid">
      {(page?.testimonialsTop ?? []).map((t) => (
        <div class="testi-card">
          <p class="quote">{t.quote}</p>
          <div class="testi-who">
            {t.photo ? (
              <img class="avatar" src={urlFor(t.photo).width(40).height(40).url()} alt={t.name} />
            ) : (
              <div class="avatar"></div>
            )}
            <span>{t.name}, {t.role}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="problem">
  <div class="wrap">
    <p class="eyebrow">
      <svg class="mark" viewBox="0 0 24 24" fill="#2A5BFF"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>
      {page?.problemEyebrow}
    </p>
    <h2>{page?.problemHeading}</h2>
    <p class="body">{page?.problemBody}</p>
    <div class="pain-grid">
      {(page?.painPoints ?? []).map((p) => (
        <div class="pain-item">{p.label}</div>
      ))}
    </div>
  </div>
</section>

<section id="solution">
  <div class="wrap">
    <p class="eyebrow">
      <svg class="mark" viewBox="0 0 24 24" fill="#2A5BFF"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>
      The solution
    </p>
    <h2>{page?.solutionHeading}</h2>
    <p class="body">{page?.solutionBody}</p>
    {page?.solutionCta && (
      <a
        href={page.solutionCta.url}
        target={page.solutionCta.openInNewTab ? '_blank' : undefined}
        rel={page.solutionCta.openInNewTab ? 'noopener' : undefined}
        class="btn btn-primary"
      >
        {page.solutionCta.label}
      </a>
    )}
  </div>
</section>

<section id="process">
  <div class="wrap">
    <p class="eyebrow">
