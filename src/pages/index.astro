---
import { sanityClient, urlFor } from '../lib/sanityClient';
import { HOME_PAGE_QUERY, SITE_SETTINGS_QUERY } from '../lib/queries';

const { page, posts } = await sanityClient.fetch(HOME_PAGE_QUERY, {
  postCount: 2,
});
const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

// Fallbacks so the page still renders sensibly before Site Settings is filled in.
const navLinks = settings?.navLinks?.length
  ? settings.navLinks
  : [
      { label: 'Work', anchor: '#work' },
      { label: 'Process', anchor: '#process' },
      { label: 'Pricing', anchor: '/pricing' },
      { label: 'About', anchor: '#about' },
      { label: 'Blog', anchor: '#blog' },
      { label: 'Contact', anchor: '/contact' },
    ];
const navCta = settings?.navCta ?? {
  label: 'Chat with Mickey',
  url: '/contact',
  openInNewTab: false,
};
const footerText = settings?.footerText ?? '© 2026 Mickey Bowen';
const socialLinks = settings?.socialLinks ?? [];

const seoTitle = page?.seoTitle || settings?.defaultSeoTitle || (settings?.siteName ?? 'Mickey Bowen');
const seoDescription = page?.seoDescription || settings?.defaultSeoDescription;

const heroReassurance = page?.heroReassurance?.length
  ? page.heroReassurance
  : ['Fixed price, no surprises', '14-day turnaround', 'No Agency Overhead'];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{seoTitle}</title>
  {seoDescription && <meta name="description" content={seoDescription} />}
</head>
<body>
<style>
  :root {
    --ink: #0F0E0C;
    --ink-soft: #6B6558;
    --ink-faint: #A39C8C;
    --bg: #F7F5F0;
    --panel: #FFFFFF;
    --line: #E5E1D8;
    --accent: #0F0E0C;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding-top: 72px;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 32px; }
  h1, h2 { font-family: 'Lora', Georgia, serif; font-weight: 600; letter-spacing: -0.01em; }
  a { color: inherit; text-decoration: none; }
  .serif-italic { font-family: 'Lora', Georgia, serif; font-style: italic; font-weight: 400; }
  .eyebrow {
    display: inline-flex; align-items: center;
    font-size: 11.5px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .eyebrow.center { justify-content: center; width: 100%; }
  section { scroll-margin-top: 24px; }

  .nav-bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(247, 245, 240, 0.82);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 32px; max-width: 1080px; margin: 0 auto; box-sizing: border-box;
  }
  nav .logo { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; }
  .nav-cta { display: flex; align-items: center; gap: 10px; }
  .nav-avatar {
    width: 32px; height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--line); display: flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 2px var(--bg);
  }
  .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .cta-short { display: none; }
  nav .links { display: flex; gap: 34px; font-size: 14px; color: var(--ink); font-weight: 500; }
  nav .links a:hover { opacity: 0.7; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border: none; border-radius: 999px; font-size: 15px; font-weight: 600;
    cursor: pointer; font-family: 'Inter', sans-serif; transition: opacity 0.15s ease;
  }
  .btn:hover { opacity: 0.78; }
  .btn-primary { background: var(--ink); color: var(--bg); height: 48px; padding: 0 32px; }
  .btn-secondary { background: transparent; color: var(--ink); border: 1px solid var(--line); height: 48px; padding: 0 32px; }
  .btn-link { font-size: 15px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; display: inline-flex; align-items: center; gap: 6px; }
  nav .btn-primary, nav .btn-secondary { height: 40px; padding: 0 22px; font-size: 14px; border-radius: 999px; }

  #hero { padding: 88px 32px 72px; max-width: 1080px; margin: 0 auto; box-sizing: border-box; }
  #hero .hero-inner {
    max-width: 720px; margin: 0 auto; display: flex; flex-direction: column;
    align-items: center; text-align: center; gap: 22px;
  }
  #hero h1 { font-size: clamp(32px, 4.4vw, 52px); line-height: 1.18; margin: 0; white-space: pre-line; }
  #hero p.lede { font-size: 19px; line-height: 1.55; margin: 0; max-width: 560px; color: var(--ink-soft); }
  .reassure { display: flex; gap: 26px; flex-wrap: wrap; justify-content: center; margin: 4px 0 0; }
  .reassure-item { display: flex; align-items: center; gap: 7px; font-size: 13.5px; color: var(--ink-faint); font-weight: 500; }
  .reassure-item svg { flex-shrink: 0; }
  .btn-row { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 4px; }

  #logos { padding: 44px 0 64px; border-top: 1px solid var(--line); overflow: hidden; }
  .logo-marquee {
    margin-top: 32px;
    -webkit-mask-image: linear-gradient(to right, transparent, black 80px, black calc(100% - 80px), transparent);
    mask-image: linear-gradient(to right, transparent, black 80px, black calc(100% - 80px), transparent);
  }
  .logo-track {
    display: flex;
    align-items: center;
    gap: 24px;
    width: max-content;
    animation: logo-scroll 56s linear infinite;
  }
  .logo-track:hover { animation-play-state: paused; }
  .logo-slot { display: flex; align-items: center; justify-content: center; height: 40px; width: 140px; flex-shrink: 0; }
  .logo-slot img { max-height: 32px; max-width: 108px; width: auto; height: auto; object-fit: contain; filter: brightness(0); opacity: 0.4; }
  .logo-slot img.logo-native { filter: none; opacity: 1; }
  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track { animation: none; }
  }

  #testimonials-top { padding: 0 0 88px; }
  .testi-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .testi-card { border: 1px solid var(--line); border-radius: 16px; padding: 28px; background: var(--panel); }
  .testi-card p.quote { font-size: 16px; line-height: 1.6; margin: 0 0 18px; font-weight: 500; }
  .testi-who { display: flex; align-items: center; gap: 12px; }
  .avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--line); flex-shrink: 0; }
  .testi-who span { font-size: 13px; color: var(--ink-soft); }

  #problem { padding: 96px 0; border-top: 1px solid var(--line); }
  #problem h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.2; margin: 0 0 18px; max-width: 580px; }
  #problem p.body { font-size: 16px; color: var(--ink-soft); line-height: 1.7; margin: 0 0 32px; max-width: 580px; }
  .pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .pain-item span { display: block; font-size: 14px; color: var(--ink); margin-top: 12px; font-weight: 500; }

  #solution { padding: 96px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--panel); }
  #solution h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.2; margin: 0 0 16px; max-width: 580px; }
  #solution p.body { font-size: 18px; color: var(--ink); line-height: 1.6; margin: 0 0 28px; max-width: 580px; font-weight: 500; }

  #process { padding: 96px 0; border-bottom: 1px solid var(--line); }
  #process h2 { font-size: clamp(24px, 2.6vw, 32px); margin: 0 0 34px; max-width: 580px; }
  .steps { display: flex; flex-direction: column; gap: 26px; max-width: 640px; }
  .step-item { display: flex; gap: 18px; align-items: flex-start; }
  .step-item .num {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%;
    background: var(--panel); border: 1px solid var(--line); color: var(--ink); font-weight: 700; font-size: 14px;
    display: flex; align-items: center; justify-content: center;
  }
  .step-item .name { font-size: 16px; font-weight: 700; margin: 6px 0 6px; color: var(--ink); }
  .step-item .desc { font-size: 14.5px; color: var(--ink-soft); line-height: 1.6; margin: 0; }

  #pricing { padding: 96px 0; border-bottom: 1px solid var(--line); background: var(--panel); }
  #pricing h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.2; margin: 0 0 16px; max-width: 580px; }
  #pricing p.body { font-size: 16px; color: var(--ink-soft); line-height: 1.7; margin: 0 0 40px; max-width: 580px; }
  .pricing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
  .price-card { background: var(--bg); border: 1px solid var(--line); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; position: relative; }
  .price-badge { position: absolute; top: -12px; left: 28px; background: var(--ink); color: var(--bg); font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 999px; letter-spacing: 0.02em; }
  .price-card h3 { font-size: 20px; font-weight: 700; margin: 0 0 4px; font-family: 'Inter', sans-serif; }
  .price-card .price-tag { font-size: 38px; font-weight: 800; letter-spacing: -0.02em; margin: 14px 0 2px; }
  .price-card .price-sub { font-size: 13px; color: var(--ink-soft); margin: 0 0 20px; }
  .price-card .price-desc { font-size: 14.5px; color: var(--ink-soft); line-height: 1.65; margin: 0 0 22px; }
  .price-list { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .price-list li { display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 500; }
  .price-card .btn { margin-top: auto; width: 100%; justify-content: center; }

  .audit-card {
    display: flex; align-items: center; justify-content: space-between; gap: 32px;
    background: var(--bg); border: 1px solid var(--line); border-radius: 16px;
    padding: 32px 36px; margin-top: 24px; flex-wrap: wrap;
  }
  .audit-info { flex: 1 1 380px; min-width: 0; }
  .audit-info .duration { font-size: 12px; font-weight: 500; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 10px; }
  .audit-info h3 { font-size: 20px; font-weight: 700; margin: 0 0 8px; font-family: 'Inter', sans-serif; }
  .audit-info .price-desc { font-size: 14.5px; color: var(--ink-soft); line-height: 1.65; margin: 0; max-width: 520px; }
  .audit-action { display: flex; align-items: center; gap: 20px; flex-shrink: 0; }
  .audit-action .price-sub { font-size: 13px; color: var(--ink-soft); margin: 0 0 2px; }
  .audit-action .price-tag { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; margin: 0; }
  .audit-action .btn { white-space: nowrap; height: 48px; padding: 0 24px; width: auto; }

  @media (max-width: 760px) {
    .audit-card { flex-direction: column; align-items: stretch; padding: 28px 24px; }
    .audit-action { flex-direction: column; align-items: stretch; gap: 12px; }
    .audit-action .price-sub, .audit-action .price-tag { text-align: left; }
  }

  #about { padding: 96px 0; border-bottom: 1px solid var(--line); }
  .about-grid { display: grid; grid-template-columns: 0.55fr 1fr; gap: 48px; align-items: center; }
  .about-photo { width: 100%; max-width: 320px; aspect-ratio: 1/1; border-radius: 50%; background: var(--panel); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }
  #about h2 { font-size: clamp(22px, 2.4vw, 28px); margin: 0 0 22px; }
  .about-list { display: flex; flex-direction: column; gap: 14px; }
  .about-item { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 500; }

  #work { padding: 96px 0; border-bottom: 1px solid var(--line); }
  .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .work-tile {
    background: var(--panel) top center/cover no-repeat; border: 1px solid var(--line); border-radius: 16px; aspect-ratio: 3/2;
    display: flex; align-items: flex-end; padding: 20px; overflow: hidden;
    cursor: pointer; text-align: left; width: 100%; font-family: inherit;
  }
  .work-tile span {
    font-size: 14px; font-weight: 600; background: rgba(247, 245, 240, 0.94); color: var(--ink);
    padding: 6px 12px; border-radius: 8px;
  }

  .lightbox {
    position: fixed; inset: 0; z-index: 1000; display: none;
    align-items: center; justify-content: center; padding: 40px;
    background: rgba(15, 14, 12, 0.88);
  }
  .lightbox.open { display: flex; }
  .lightbox img { max-width: 100%; max-height: 100%; border-radius: 8px; display: block; }
  .lightbox-close {
    position: absolute; top: 20px; right: 24px; width: 40px; height: 40px; border-radius: 50%;
    background: var(--bg); color: var(--ink); border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 20px;
  }

  #faq { padding: 96px 0; border-bottom: 1px solid var(--line); }
  .faq-list { max-width: 640px; }
  .faq-item { border-bottom: 1px solid var(--line); padding-bottom: 24px; margin-bottom: 24px; }
  .faq-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .faq-item .q { font-size: 16px; font-weight: 600; margin: 0 0 10px; }
  .faq-item .a { font-size: 14.5px; color: var(--ink-soft); line-height: 1.65; margin: 0; }
  .faq-item .a a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  #final-testimonial { padding: 96px 0 0; }
  .final-testi { border: 1px solid var(--line); border-radius: 16px; padding: 36px; max-width: 560px; margin: 0 auto; text-align: center; background: var(--panel); }
  .final-testi p.quote { font-size: 19px; line-height: 1.55; margin: 0 0 14px; font-weight: 500; }
  .final-testi p.who { font-size: 13px; color: var(--ink-soft); margin: 0; }

  #contact { padding: 80px 0 64px; text-align: center; }
  #contact h2 { font-size: clamp(24px, 2.8vw, 32px); margin: 0 0 14px; }
  #contact p.sub { font-size: 15px; color: var(--ink-soft); margin: 0 0 26px; }
  .mini-testi { max-width: 440px; margin: 28px auto 0; }
  .mini-testi-quote { font-size: 14.5px; color: var(--ink-soft); font-style: italic; font-family: 'Lora', Georgia, serif; line-height: 1.55; margin: 0 0 8px; }
  .mini-testi-who { font-size: 12.5px; color: var(--ink-faint); margin: 0; }

  #blog { padding: 96px 0; border-top: 1px solid var(--line); }
  .blog-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
  .blog-head a { font-size: 14px; color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .blog-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .blog-thumb { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; aspect-ratio: 16/9; margin-bottom: 14px; }
  .blog-grid h3 { font-size: 15px; font-weight: 600; margin: 0 0 5px; }
  .blog-grid time { font-size: 12.5px; color: var(--ink-faint); }

  footer {
    border-top: 1px solid var(--line); padding: 28px 32px; display: flex;
    justify-content: space-between; font-size: 13px; color: var(--ink-faint);
    max-width: 1080px; margin: 0 auto; box-sizing: border-box;
  }

  @media (max-width: 900px) {
    .testi-grid, .work-grid, .blog-grid, .pricing-grid { grid-template-columns: 1fr; }
    .pain-grid { grid-template-columns: repeat(2, 1fr); }
    .about-grid { grid-template-columns: 1fr; text-align: left; }
    .about-photo { margin: 0 0 16px; max-width: 200px; }
    nav .links { display: none; }
  }
  @media (max-width: 560px) {
    .wrap { padding-left: 20px; padding-right: 20px; }
    #hero, nav, footer { padding-left: 20px; padding-right: 20px; }
    .cta-full { display: none; }
    .cta-short { display: inline; }
    .pain-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .btn-row { flex-direction: column; align-items: stretch; }
    .btn-row .btn { width: 100%; }
    .reassure { flex-direction: column; align-items: center; gap: 10px; }
  }
</style>
<div class="nav-bar">
<nav>
  <span class="logo">
    <span class="nav-avatar">
      <img
        src={settings?.navAvatar ? urlFor(settings.navAvatar).width(72).height(72).url() : '/images/mickey-headshot.jpg'}
        alt={settings?.siteName ?? 'Mickey Bowen'}
      />
    </span>
    {settings?.siteName ?? 'Mickey Bowen'}
  </span>
  <div class="links">
    {navLinks.map((link) => (
      <a href={link.anchor}>{link.label}</a>
    ))}
  </div>
  <div class="nav-cta">
    <a
      href={navCta.url}
      target={navCta.openInNewTab ? '_blank' : undefined}
      rel={navCta.openInNewTab ? 'noopener' : undefined}
      class="btn btn-primary nav-btn"
    >
      {navCta.label}
    </a>
  </div>
</nav>
</div>

<section id="hero">
  <div class="hero-inner">
    <p class="eyebrow">{page?.heroPreHeadline}</p>
    <h1>{page?.heroHeadline}</h1>
    <p class="lede serif-italic">{page?.heroSubtext}</p>
    <div class="reassure">
      {heroReassurance.map((item) => (
        <div class="reassure-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
          {item}
        </div>
      ))}
    </div>
    <div class="btn-row">
      {page?.heroPrimaryCta && (
        <a
          href={page.heroPrimaryCta.url}
          target={page.heroPrimaryCta.openInNewTab ? '_blank' : undefined}
          rel={page.heroPrimaryCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-primary"
        >
          {page.heroPrimaryCta.label}
        </a>
      )}
      {page?.heroSecondaryCta && (
        <a
          href={page.heroSecondaryCta.url}
          target={page.heroSecondaryCta.openInNewTab ? '_blank' : undefined}
          rel={page.heroSecondaryCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-secondary"
        >
          Chat with Mickey
        </a>
      )}
    </div>
  </div>
</section>

{(() => {
  const logoList = page?.logos?.length ? page.logos : [null, null, null, null, null];
  // Rendered twice back-to-back so the marquee can loop seamlessly: the
  // CSS animation scrolls exactly one set-width (translateX(-50%)) then resets.
  const renderLogo = (logo) => {
    // Pre-colored locally so the "Ad" mark cutout can stay white while the
    // rest matches the shared gray filter below - CSS filters alone can't
    // treat one region of an image differently from the rest.
    const isAdConversion = logo?.asset?._ref === 'image-c28e463027cc9df6e467d6433c1d745031d831bb-290x70-svg';
    // Same problem as AdConversion: a white "re" cutout sits on a colored
    // box, so it gets a pre-colored local asset too (box + wordmark baked
    // to the shared gray, "re" cutout kept white).
    const isReData = logo?.asset?._ref === 'image-31f7f0f2f7a2fee97343f8b444d0fabf0e30a485-669x288-svg';
    return (
      <div class="logo-slot">
        {logo && isAdConversion && (
          <img src="/images/adconversion-logo-gray.svg" alt="" class="logo-native" />
        )}
        {logo && isReData && (
          <img src="/images/redata-logo-gray.svg" alt="" class="logo-native" />
        )}
        {logo && !isAdConversion && !isReData && (
          <img src={urlFor(logo).height(80).url()} alt="" />
        )}
      </div>
    );
  };
  return (
    <section id="logos">
      <div class="wrap">
        <p class="eyebrow center">{page?.logoCloudHeading}</p>
      </div>
      <div class="logo-marquee">
        <div class="logo-track">
          {logoList.map((logo) => renderLogo(logo))}
          {logoList.map((logo) => renderLogo(logo))}
        </div>
      </div>
    </section>
  );
})()}

<section id="testimonials-top">
  <div class="wrap">
    <div class="testi-grid">
      {(page?.testimonialsTop ?? []).map((t) => (
        <div class="testi-card">
          <p class="quote">{t.quote}</p>
          <div class="testi-who">
            {t.photo ? (
              <img class="avatar" src={urlFor(t.photo).width(40).height(40).url()} alt={t.name} />
            ) : (
              <div class="avatar"></div>
            )}
            <span>{t.name}, {t.role}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="problem">
  <div class="wrap">
    <p class="eyebrow">{page?.problemEyebrow}</p>
    <h2>{page?.problemHeading}</h2>
    <p class="body">{page?.problemBody}</p>
    <div class="pain-grid">
      {(page?.painPoints ?? []).map((p) => (
        <div class="pain-item">{p.label}</div>
      ))}
    </div>
  </div>
</section>

<section id="solution">
  <div class="wrap">
    <p class="eyebrow">The solution</p>
    <h2>{page?.solutionHeading}</h2>
    <p class="body">{page?.solutionBody}</p>
    {page?.solutionCta && (
      <a
        href={page.solutionCta.url}
        target={page.solutionCta.openInNewTab ? '_blank' : undefined}
        rel={page.solutionCta.openInNewTab ? 'noopener' : undefined}
        class="btn btn-primary"
      >
        {page.solutionCta.label}
      </a>
    )}
  </div>
</section>

<section id="process">
  <div class="wrap">
    <p class="eyebrow">Our process</p>
    <h2>{page?.processHeading}</h2>
    <div class="steps">
      {(page?.processSteps ?? []).map((s) => (
        <div class="step-item">
          <span class="num">{s.number}</span>
          <div>
            <p class="name">{s.name}</p>
            {s.description && <p class="desc">{s.description}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="pricing">
  <div class="wrap">
    <p class="eyebrow">{page?.pricingEyebrow}</p>
    <h2>{page?.pricingHeading}</h2>
    <p class="body">{page?.pricingBody}</p>
    {(() => {
      const plans = page?.pricingPlans ?? [];
      const sprintPlans = plans.slice(0, 2);
      const auditPlan = plans[2];
      return (
        <>
          <div class="pricing-grid">
            {sprintPlans.map((plan) => (
              <div class="price-card">
                {plan.featured && plan.badge && <span class="price-badge">{plan.badge}</span>}
                <h3>{plan.name}</h3>
                <p class="price-tag">{plan.price}</p>
                {plan.priceSub && <p class="price-sub">{plan.priceSub}</p>}
                {plan.description && <p class="price-desc">{plan.description}</p>}
                <ul class="price-list">
                  {(plan.features ?? []).map((f) => (
                    <li>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                      {f}
                    </li>
                  ))}
                </ul>
                {plan.cta && (
                  <a
                    href={plan.cta.url}
                    target={plan.cta.openInNewTab ? '_blank' : undefined}
                    rel={plan.cta.openInNewTab ? 'noopener' : undefined}
                    class={`btn ${plan.featured ? 'btn-primary' : 'btn-secondary'}`}
                  >
                    {plan.cta.label}
                  </a>
                )}
              </div>
            ))}
          </div>
          {auditPlan && (
            <div class="audit-card">
              <div class="audit-info">
                {auditPlan.priceSub && <p class="duration">{auditPlan.priceSub}</p>}
                <h3>{auditPlan.name}</h3>
                {auditPlan.description && <p class="price-desc">{auditPlan.description}</p>}
              </div>
              <div class="audit-action">
                <p class="price-sub">Starting at</p>
                <p class="price-tag">{auditPlan.price}</p>
                {auditPlan.cta && (
                  <a
                    href={auditPlan.cta.url}
                    target={auditPlan.cta.openInNewTab ? '_blank' : undefined}
                    rel={auditPlan.cta.openInNewTab ? 'noopener' : undefined}
                    class="btn btn-secondary"
                  >
                    {auditPlan.cta.label}
                  </a>
                )}
              </div>
            </div>
          )}
        </>
      );
    })()}
  </div>
</section>

<section id="about">
  <div class="wrap about-grid">
    <div class="about-photo">
      <img
        src={page?.aboutPhoto ? urlFor(page.aboutPhoto).width(480).height(480).url() : '/images/mickey-headshot.jpg'}
        alt={page?.aboutHeading ?? 'Mickey Bowen'}
      />
    </div>

    <div>
      <p class="eyebrow">{page?.aboutEyebrow}</p>
      <h2>{page?.aboutHeading}</h2>
      <div class="about-list">
        {(page?.aboutBullets ?? []).map((b) => (
          <div class="about-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            {b.text}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="work">
  <div class="wrap">
    <p class="eyebrow">{page?.workHeading}</p>
    <div class="work-grid">
      {(page?.workItems ?? []).map((item) => (
        <button
          type="button"
          class="work-tile"
          style={item.image ? `background-image:url(${urlFor(item.image).width(600).url()});` : ''}
          data-full={item.image ? urlFor(item.image).width(1600).url() : ''}
          data-title={item.title}
        >
          <span>{item.title}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<div class="lightbox" id="work-lightbox">
  <button type="button" class="lightbox-close" id="work-lightbox-close" aria-label="Close preview">&times;</button>
  <img id="work-lightbox-img" src="" alt="" />
</div>

<section id="faq">
  <div class="wrap">
    <p class="eyebrow">FAQ</p>
    <div class="faq-list">
      {(page?.faqItems ?? []).map((item) => (
        <div class="faq-item">
          <p class="q">{item.question}</p>
          <p class="a" set:html={item.answer} />
        </div>
      ))}
    </div>
  </div>
</section>

{page?.finalTestimonial && (
  <section id="final-testimonial">
    <div class="wrap">
      <div class="final-testi">
        <p class="quote">{page.finalTestimonial.quote}</p>
        <p class="who">{page.finalTestimonial.name}, {page.finalTestimonial.role}</p>
      </div>
    </div>
  </section>
)}

<section id="contact">
  <div class="wrap">
    <h2>{page?.ctaHeading}</h2>
    <p class="sub">{page?.ctaSubtext}</p>
    {page?.ctaButton && (
      <a
        href={page.ctaButton.url}
        target={page.ctaButton.openInNewTab ? '_blank' : undefined}
        rel={page.ctaButton.openInNewTab ? 'noopener' : undefined}
        class="btn btn-primary"
      >
        {page.ctaButton.label}
      </a>
    )}
    {page?.ctaTestimonialQuote && (
      <div class="mini-testi">
        <p class="mini-testi-quote">&ldquo;{page.ctaTestimonialQuote}&rdquo;</p>
        {page?.ctaTestimonialAttribution && <p class="mini-testi-who">{page.ctaTestimonialAttribution}</p>}
      </div>
    )}
  </div>
</section>

<section id="blog">
  <div class="wrap">
    <div class="blog-head">
      <p class="eyebrow" style="margin:0;">{page?.blogHeading}</p>
      <a href="/blog">View all</a>
    </div>
    <div class="blog-grid">
      {(posts ?? []).map((post) => (
        <a href={`/blog/${post.slug?.current}`}>
          <div class="blog-thumb" style={post.mainImage ? `background-image:url(${urlFor(post.mainImage).width(500).url()});` : ''}></div>
          <h3>{post.title}</h3>
          <time>{new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        </a>
      ))}
    </div>
  </div>
</section>

<footer>
  <span>{footerText}</span>
  <span>
    {socialLinks.map((s, i) => (
      <>
        {i > 0 && ' · '}
        <a href={s.url} target="_blank" rel="noopener">{s.platform}</a>
      </>
    ))}
  </span>
</footer>

<script>
  const lightbox = document.getElementById('work-lightbox');
  const lightboxImg = document.getElementById('work-lightbox-img');
  const closeBtn = document.getElementById('work-lightbox-close');

  function openLightbox(src, alt) {
    if (!lightbox || !lightboxImg || !src) return;
    lightboxImg.setAttribute('src', src);
    lightboxImg.setAttribute('alt', alt || '');
    lightbox.classList.add('open');
  }
  function closeLightbox() {
    lightbox?.classList.remove('open');
    lightboxImg?.setAttribute('src', '');
  }

  document.querySelectorAll('.work-tile').forEach((tile) => {
    tile.addEventListener('click', () => {
      openLightbox(tile.getAttribute('data-full'), tile.getAttribute('data-title'));
    });
  });
  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
</body>
</html>
