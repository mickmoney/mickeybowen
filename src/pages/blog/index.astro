---
import { sanityClient, urlFor } from '../../lib/sanityClient';
import { BLOG_LIST_QUERY, SITE_SETTINGS_QUERY } from '../../lib/queries';

const posts = await sanityClient.fetch(BLOG_LIST_QUERY);
const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

const navLinks = settings?.navLinks?.length
  ? settings.navLinks
  : [
      { label: 'Work', anchor: '/#work' },
      { label: 'Process', anchor: '/#process' },
      { label: 'Pricing', anchor: '/pricing' },
      { label: 'About', anchor: '/#about' },
      { label: 'Blog', anchor: '/blog' },
    ];
const navCta = settings?.navCta ?? {
  label: 'Chat with Mickey',
  url: 'https://wa.me/5016082944',
  openInNewTab: true,
};
const footerText = settings?.footerText ?? '© 2026 Mickey Bowen';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>Blog | {settings?.siteName ?? 'Mickey Bowen'}</title>
</head>
<body>
  <div class="nav-bar">
    <nav>
      <a href="/" class="logo">
        <span class="nav-avatar">
          <img
            src={settings?.navAvatar ? urlFor(settings.navAvatar).width(72).height(72).url() : '/images/mickey-headshot.jpg'}
            alt={settings?.siteName ?? 'Mickey Bowen'}
          />
        </span>
        {(settings?.siteName ?? 'Mickey Bowen').toLowerCase()}
      </a>
      <div class="links">
        {navLinks.map((link) => (
          <a href={link.anchor}>{link.label}</a>
        ))}
      </div>
      <div class="nav-cta">
        <a
          href={navCta.url}
          target={navCta.openInNewTab ? '_blank' : undefined}
          rel={navCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-primary nav-btn"
        >
          {navCta.label}
        </a>
      </div>
    </nav>
  </div>

  <section id="blog-index">
    <div class="wrap">
      <h1>From the blog</h1>
      <p class="sub">Notes on landing pages, conversion, and B2B SaaS marketing.</p>

      {posts?.length ? (
        <div class="blog-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug?.current}`} class="blog-card">
              <div
                class="blog-thumb"
                style={post.mainImage ? `background-image:url(${urlFor(post.mainImage).width(600).height(375).fit('crop').crop('top').url()});` : ''}
              ></div>
              <h3>{post.title}</h3>
              {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
              <time>
                {new Date(post.publishedAt).toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">No posts published yet - check back soon.</p>
      )}
    </div>
  </section>

  <footer>
    <span>{footerText}</span>
  </footer>
</body>
</html>

<style>
  :root {
    --ink: #0F0E0C;
    --ink-soft: #6B6558;
    --ink-faint: #A39C8C;
    --bg: #F7F5F0;
    --panel: #FFFFFF;
    --line: #E5E1D8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding-top: 72px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    background: var(--bg);
  }
  a { color: inherit; text-decoration: none; }
  h1 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -0.01em; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

  .nav-bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(247, 245, 240, 0.82);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  nav {
    max-width: 1080px; margin: 0 auto; padding: 16px 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; text-transform: lowercase; }
  .nav-avatar {
    width: 32px; height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--line); display: flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 2px var(--bg);
  }
  .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .links { display: flex; gap: 28px; font-size: 14px; color: var(--ink); }
  .links a:hover { opacity: 0.7; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; border-radius: 999px; font-weight: 600; font-size: 14px; }
  .btn-primary { background: var(--ink); color: var(--bg); }

  #blog-index { padding: 72px 0 100px; }
  h1 { font-size: 36px; margin: 0 0 8px; }
  .sub { color: var(--ink-soft); margin: 0 0 40px; }

  .blog-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 28px;
  }
  .blog-card { display: block; }
  .blog-thumb {
    aspect-ratio: 16/10; background: var(--panel) center/cover no-repeat;
    border-radius: 12px; border: 1px solid var(--line); margin-bottom: 14px;
  }
  .blog-card h3 { font-size: 18px; margin: 0 0 6px; font-family: 'Inter', sans-serif; font-weight: 600; }
  .blog-card .excerpt { color: var(--ink-soft); font-size: 14px; margin: 0 0 8px; line-height: 1.5; }
  .blog-card time { color: var(--ink-faint); font-size: 13px; }

  .empty { color: var(--ink-soft); }

  footer {
    padding: 28px 24px; border-top: 1px solid var(--line);
    color: var(--ink-faint); font-size: 13px; text-align: center;
  }

  @media (max-width: 640px) {
    nav { flex-wrap: wrap; }
    .links { gap: 18px; }
  }
</style>
