---
import { sanityClient, urlFor } from '../../lib/sanityClient';
import { ALL_POST_SLUGS_QUERY, POST_BY_SLUG_QUERY, SITE_SETTINGS_QUERY } from '../../lib/queries';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(ALL_POST_SLUGS_QUERY);
  return (slugs ?? []).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(POST_BY_SLUG_QUERY, { slug });
const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

const navLinks = settings?.navLinks?.length
  ? settings.navLinks
  : [
      { label: 'Work', anchor: '/#work' },
      { label: 'Process', anchor: '/#process' },
      { label: 'Pricing', anchor: '/pricing' },
      { label: 'About', anchor: '/#about' },
      { label: 'Blog', anchor: '/blog' },
      { label: 'Contact', anchor: '/contact' },
    ];
const navCta = settings?.navCta ?? {
  label: 'Chat with Mickey',
  url: '/contact',
  openInNewTab: false,
};
const footerText = settings?.footerText ?? '© 2026 Mickey Bowen';

const authorLine = post?.author ? ' · ' + post.author : '';
const formattedDate = post?.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{post?.title ?? 'Post'} | {settings?.siteName ?? 'Mickey Bowen'}</title>
  {post?.excerpt && <meta name="description" content={post.excerpt} />}
</head>
<body>
  <div class="nav-bar">
    <nav>
      <a href="/" class="logo">
        <span class="nav-avatar">
          <img
            src={settings?.navAvatar ? urlFor(settings.navAvatar).width(72).height(72).url() : '/images/mickey-headshot.jpg'}
            alt={settings?.siteName ?? 'Mickey Bowen'}
          />
        </span>
        {settings?.siteName ?? 'Mickey Bowen'}
      </a>
      <div class="links">
        {navLinks.map((link) => (
          <a href={link.anchor}>{link.label}</a>
        ))}
      </div>
      <div class="nav-cta">
        <a
          href={navCta.url}
          target={navCta.openInNewTab ? '_blank' : undefined}
          rel={navCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-primary nav-btn"
        >
          {navCta.label}
        </a>
      </div>
    </nav>
  </div>

  <article class="wrap">
    <a href="/blog" class="back">&larr; Back to blog</a>
    <p class="meta">{formattedDate}{authorLine}</p>
    <h1>{post?.title}</h1>
    {post?.mainImage && (
      <img
        class="hero-img"
        src={urlFor(post.mainImage).width(1200).height(675).fit('crop').crop('top').url()}
        alt={post.title}
      />
    )}
    <div class="prose">
      {(post?.body ?? []).map((block) => {
        if (block._type === 'image') {
          return <img src={urlFor(block).width(900).url()} alt="" loading="lazy" />;
        }
        if (block._type !== 'block') return null;
        const text = (block.children ?? []).map((c) => c.text ?? '').join('');
        if (block.listItem) return <li>{text}</li>;
        if (block.style === 'h2') return <h2>{text}</h2>;
        if (block.style === 'h3') return <h3>{text}</h3>;
        if (block.style === 'blockquote') return <blockquote>{text}</blockquote>;
        return <p>{text}</p>;
      })}
    </div>

    {post?.tags?.length > 0 && (
      <div class="tags">
        {post.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}

    <a href="/blog" class="back back-bottom">&larr; Back to blog</a>
  </article>

  <section id="post-cta">
    <div class="wrap cta-inner">
      <h2>Need help with your B2B SaaS landing pages?</h2>
      <p class="cta-sub">Schedule a free 30-minute consult with Mickey and walk away with 3-5 optimizations you can apply yourself.</p>
      <div class="cta-row">
        <img class="cta-avatar" src="/images/mickey-headshot.jpg" alt="Mickey Bowen" />
        <a
          href="https://calendly.com/mickeybowen/30min"
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
        >
          Schedule a Free Consult
        </a>
      </div>
    </div>
  </section>

  <footer>
    <span>{footerText}</span>
  </footer>
</body>
</html>

<style>
  :root {
    --ink: #0F0E0C;
    --ink-soft: #6B6558;
    --ink-faint: #A39C8C;
    --bg: #F7F5F0;
    --panel: #FFFFFF;
    --line: #E5E1D8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding-top: 72px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    background: var(--bg);
  }
  a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  h1, h2 { font-family: 'Lora', Georgia, serif; font-weight: 600; letter-spacing: -0.01em; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 24px; }

  .nav-bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(247, 245, 240, 0.82);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  nav {
    max-width: 1080px; margin: 0 auto; padding: 16px 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; color: var(--ink); text-decoration: none; }
  .nav-avatar {
    width: 32px; height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--line); display: flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 2px var(--bg);
  }
  .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .links { display: flex; gap: 28px; font-size: 14px; color: var(--ink); }
  .links a { color: inherit; text-decoration: none; }
  .links a:hover { opacity: 0.7; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; border-radius: 999px; font-weight: 600; font-size: 14px; text-decoration: none; }
  .btn-primary { background: var(--ink); color: var(--bg); }

  article { padding: 64px 24px 56px; }
  .back-bottom { display: block; margin: 56px 0 0; }

  #post-cta {
    text-align: center; padding: 72px 24px 88px;
    background: var(--panel); border-top: 1px solid var(--line);
  }
  .cta-inner h2 { font-size: 26px; margin: 0 0 12px; }
  .cta-sub { color: var(--ink-soft); max-width: 480px; margin: 0 auto 28px; line-height: 1.5; }
  .cta-row { display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; }
  .cta-avatar {
    width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--line);
  }
  .back { font-size: 13px; font-weight: 600; display: inline-block; margin-bottom: 24px; text-decoration: none; color: var(--ink-soft); }
  .meta { color: var(--ink-faint); font-size: 13px; margin: 0 0 8px; }
  h1 { font-size: 34px; line-height: 1.2; margin: 0 0 24px; }
  .hero-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 12px; margin-bottom: 32px; display: block; border: 1px solid var(--line); }

  .prose { font-size: 17px; line-height: 1.7; color: var(--ink); }
  .prose p { margin: 0 0 20px; }
  .prose h2 {
    font-size: 24px; margin: 48px 0 14px; padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .prose h3 { font-size: 19px; margin: 28px 0 10px; font-family: 'Inter', sans-serif; font-weight: 700; }
  .prose blockquote {
    margin: 24px 0; padding: 4px 20px; border-left: 3px solid var(--ink);
    color: var(--ink-soft); font-family: 'Lora', Georgia, serif; font-style: italic;
  }
  .prose img { max-width: 100%; border-radius: 10px; margin: 24px 0; border: 1px solid var(--line); }
  .prose ul, .prose ol { margin: 0 0 20px; padding-left: 24px; }
  .prose li { margin-bottom: 8px; }
  .prose code { background: var(--panel); padding: 2px 6px; border-radius: 4px; font-size: 15px; }

  .tags { margin-top: 40px; display: flex; gap: 8px; flex-wrap: wrap; }
  .tag {
    font-size: 12px; color: var(--ink-soft); background: var(--panel);
    padding: 5px 12px; border-radius: 999px; border: 1px solid var(--line);
  }

  footer {
    padding: 28px 24px; border-top: 1px solid var(--line);
    color: var(--ink-faint); font-size: 13px; text-align: center;
  }
</style>
