---
import { sanityClient, urlFor } from '../lib/sanityClient';
import { SITE_SETTINGS_QUERY } from '../lib/queries';

const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

const navLinks = settings?.navLinks?.length
  ? settings.navLinks
  : [
      { label: 'Work', anchor: '/#work' },
      { label: 'Process', anchor: '/#process' },
      { label: 'Pricing', anchor: '/pricing' },
      { label: 'About', anchor: '/#about' },
      { label: 'Blog', anchor: '/blog' },
      { label: 'Contact', anchor: '/contact' },
    ];
const navCta = settings?.navCta ?? {
  label: 'Chat with Mickey',
  url: '/contact',
  openInNewTab: false,
};
const footerText = settings?.footerText ?? '© 2026 Mickey Bowen';

const mariaTestimonial = {
  quote: "Mickey and his team took our ad strategy full circle with helping think outside the box and think of the full customer journey experience. This helped us reduce friction and also control every step to guarantee not only conversions but good quality ones. He's strategic and creative and all around great person to work with.",
  name: 'Maria Velasquez',
  role: 'Cybersecurity Marketer, CPG Bev Founder',
};

const sprints = [
  {
    duration: '14-Day',
    name: 'Landing Page Sprint',
    tagline: 'A complete, conversion-ready landing page, built and shipped in 14 days.',
    price: '$2,500',
    features: ['Strategy & planning', 'Copy & wireframe', 'Design & build', 'Launch & QA'],
    featured: true,
    testimonial: mariaTestimonial,
  },
  {
    duration: '21-Day',
    name: 'Homepage Sprint',
    tagline: 'A complete, conversion-ready homepage, built and shipped in 21 days.',
    price: '$3,500',
    features: ['Strategy & planning', 'Copy across every core homepage section', 'Design & build', 'Launch & QA'],
    featured: false,
  },
];

const audit = {
  duration: '3-Day',
  name: 'Landing Page Audit & Strategy Session',
  tagline: 'A full audit of your current landing page, scored against my SaaS landing page rubric, plus a strategy session mapping out exactly what to fix first.',
  price: '$250',
  testimonial: mariaTestimonial,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>Pricing | {settings?.siteName ?? 'Mickey Bowen'}</title>
  <meta name="description" content="Fixed-price sprints for B2B SaaS landing pages and homepages, done for you start to finish." />
</head>
<body>
  <div class="nav-bar">
    <nav>
      <a href="/" class="logo">
        <span class="nav-avatar">
          <img
            src={settings?.navAvatar ? urlFor(settings.navAvatar).width(72).height(72).url() : '/images/mickey-headshot.jpg'}
            alt={settings?.siteName ?? 'Mickey Bowen'}
          />
        </span>
        {settings?.siteName ?? 'Mickey Bowen'}
      </a>
      <div class="links">
        {navLinks.map((link) => (
          <a href={link.anchor}>{link.label}</a>
        ))}
      </div>
      <div class="nav-cta">
        <a
          href={navCta.url}
          target={navCta.openInNewTab ? '_blank' : undefined}
          rel={navCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-primary nav-btn"
        >
          {navCta.label}
        </a>
      </div>
    </nav>
  </div>

  <main>
    <section class="pricing-hero">
      <div class="wrap">
        <h1>Pick your sprint. Get a page that's ready to launch.</h1>
        <p class="sub">Fixed-price sprints for B2B SaaS pages, done for you start to finish. Everything I build is yours to keep.</p>
      </div>
    </section>

    <section class="pricing-section">
      <div class="wrap">
        <div class="pricing-grid">
          {sprints.map((sprint) => (
            <div class="price-card">
              {sprint.featured && <span class="price-badge">Most popular</span>}
              <p class="duration">{sprint.duration}</p>
              <h3>{sprint.name}</h3>
              <p class="price-desc">{sprint.tagline}</p>
              <p class="price-sub">Starting at</p>
              <p class="price-tag">{sprint.price}</p>
              <ul class="price-list">
                {sprint.features.map((f) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/apply" class={`btn ${sprint.featured ? 'btn-primary' : 'btn-secondary'}`}>
                Apply to work with me 1-on-1
              </a>
              {sprint.testimonial && (
                <div class="card-testi">
                  <p class="card-testi-quote">&ldquo;{sprint.testimonial.quote}&rdquo;</p>
                  <p class="card-testi-who">{sprint.testimonial.name}, {sprint.testimonial.role}</p>
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="audit-card">
          <div class="audit-info">
            <p class="duration">{audit.duration}</p>
            <h3>{audit.name}</h3>
            <p class="price-desc">{audit.tagline}</p>
            {audit.testimonial && (
              <div class="card-testi">
                <p class="card-testi-quote">&ldquo;{audit.testimonial.quote}&rdquo;</p>
                <p class="card-testi-who">{audit.testimonial.name}, {audit.testimonial.role}</p>
              </div>
            )}
          </div>
          <div class="audit-action">
            <p class="price-sub">Starting at</p>
            <p class="price-tag">{audit.price}</p>
            <a href="/apply" class="btn btn-secondary">Apply to work with me 1-on-1</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <span>{footerText}</span>
  </footer>
</body>
</html>

<style>
  :root {
    --ink: #0F0E0C;
    --ink-soft: #6B6558;
    --ink-faint: #A39C8C;
    --bg: #F7F5F0;
    --panel: #FFFFFF;
    --line: #E5E1D8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding-top: 72px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    background: var(--bg);
  }
  a { color: inherit; text-decoration: none; }
  h1 { font-family: 'Lora', Georgia, serif; font-weight: 600; letter-spacing: -0.01em; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 32px; }

  .nav-bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(247, 245, 240, 0.82);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  nav {
    max-width: 1080px; margin: 0 auto; padding: 16px 32px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; }
  .nav-avatar {
    width: 32px; height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--line); display: flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 2px var(--bg);
  }
  .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .links { display: flex; gap: 28px; font-size: 14px; color: var(--ink); }
  .links a:hover { opacity: 0.7; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 22px; border-radius: 999px; font-weight: 600; font-size: 14px; border: none; cursor: pointer; font-family: inherit; }
  nav .btn { height: 40px; padding: 0 22px; font-size: 14px; }
  .btn-primary { background: var(--ink); color: var(--bg); }
  .btn-secondary { background: transparent; color: var(--ink); border: 1px solid var(--line); }

  .pricing-hero { padding: 80px 0 16px; text-align: center; }
  .pricing-hero h1 { font-size: clamp(30px, 4vw, 44px); line-height: 1.15; margin: 0 auto 16px; max-width: 680px; }
  .pricing-hero .sub { font-size: 17px; color: var(--ink-soft); line-height: 1.6; max-width: 520px; margin: 0 auto; }

  .pricing-section { padding: 56px 0 112px; }
  .pricing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
  .price-card { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 36px 32px; display: flex; flex-direction: column; position: relative; }
  .price-badge { position: absolute; top: -12px; left: 32px; background: var(--ink); color: var(--bg); font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 999px; letter-spacing: 0.02em; }
  .price-card .duration { font-size: 12px; font-weight: 500; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 10px; }
  .price-card h3 { font-size: 22px; font-weight: 700; margin: 0 0 10px; font-family: 'Inter', sans-serif; }
  .price-card .price-desc { font-size: 14.5px; color: var(--ink-soft); line-height: 1.6; margin: 0 0 22px; }
  .price-card .price-sub { font-size: 13px; color: var(--ink-faint); margin: 0; }
  .price-card .price-tag { font-size: 38px; font-weight: 800; letter-spacing: -0.02em; margin: 2px 0 20px; }
  .price-list { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .price-list li { display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 500; }
  .price-card .btn { margin-top: auto; width: 100%; height: 48px; }
  .card-testi { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line); }
  .card-testi-quote { font-size: 13.5px; font-style: italic; font-family: 'Lora', Georgia, serif; color: var(--ink-soft); line-height: 1.55; margin: 0 0 8px; }
  .card-testi-who { font-size: 12px; color: var(--ink-faint); margin: 0; }

  .audit-card {
    display: flex; align-items: center; justify-content: space-between; gap: 32px;
    background: var(--panel); border: 1px solid var(--line); border-radius: 16px;
    padding: 32px 36px; margin-top: 24px; flex-wrap: wrap;
  }
  .audit-info { flex: 1 1 380px; min-width: 0; }
  .audit-info .duration { font-size: 12px; font-weight: 500; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 10px; }
  .audit-info h3 { font-size: 20px; font-weight: 700; margin: 0 0 8px; font-family: 'Inter', sans-serif; }
  .audit-info .price-desc { font-size: 14.5px; color: var(--ink-soft); line-height: 1.6; margin: 0; max-width: 520px; }
  .audit-action { display: flex; align-items: center; gap: 20px; flex-shrink: 0; }
  .audit-action .price-sub { font-size: 13px; color: var(--ink-faint); margin: 0 0 2px; }
  .audit-action .price-tag { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; margin: 0; }
  .audit-action .btn { white-space: nowrap; height: 48px; padding: 0 24px; }

  footer {
    padding: 28px 32px; border-top: 1px solid var(--line);
    color: var(--ink-faint); font-size: 13px; text-align: center;
  }

  @media (max-width: 760px) {
    nav { flex-wrap: wrap; }
    .links { display: none; }
    .pricing-grid { grid-template-columns: 1fr; }
    .audit-card { flex-direction: column; align-items: stretch; padding: 28px 24px; }
    .audit-action { flex-direction: column; align-items: stretch; gap: 12px; }
    .audit-action .price-sub, .audit-action .price-tag { text-align: left; }
  }
</style>
