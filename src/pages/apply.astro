---
import { sanityClient, urlFor } from '../lib/sanityClient';
import { APPLY_PAGE_QUERY, SITE_SETTINGS_QUERY } from '../lib/queries';

const page = await sanityClient.fetch(APPLY_PAGE_QUERY);
const settings = await sanityClient.fetch(SITE_SETTINGS_QUERY);

const navLinks = settings?.navLinks?.length
  ? settings.navLinks
  : [
      { label: 'Work', anchor: '/#work' },
      { label: 'Process', anchor: '/#process' },
      { label: 'Pricing', anchor: '/pricing' },
      { label: 'About', anchor: '/#about' },
      { label: 'Blog', anchor: '/blog' },
      { label: 'Contact', anchor: '/contact' },
    ];
const navCta = settings?.navCta ?? {
  label: 'Chat with Mickey',
  url: '/contact',
  openInNewTab: false,
};
const footerText = settings?.footerText ?? '© 2026 Mickey Bowen';

const rating = page?.socialProofRating ?? 4.5;
const fullStars = Math.round(rating);
const proofText = page?.socialProofText ?? 'based on 30+ client reviews';
const avatars = (page?.testimonialsTop ?? []).map((t) => t.photo).filter(Boolean);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>Apply | {settings?.siteName ?? 'Mickey Bowen'}</title>
  <meta name="description" content="Tell me a bit about your team so I can see if a landing page sprint is the right fit." />
</head>
<body>
  <div class="nav-bar">
    <nav>
      <a href="/" class="logo">
        <span class="nav-avatar">
          <img
            src={settings?.navAvatar ? urlFor(settings.navAvatar).width(72).height(72).url() : '/images/mickey-headshot.jpg'}
            alt={settings?.siteName ?? 'Mickey Bowen'}
          />
        </span>
        {settings?.siteName ?? 'Mickey Bowen'}
      </a>
      <div class="links">
        {navLinks.map((link) => (
          <a href={link.anchor}>{link.label}</a>
        ))}
      </div>
      <div class="nav-cta">
        <a
          href={navCta.url}
          target={navCta.openInNewTab ? '_blank' : undefined}
          rel={navCta.openInNewTab ? 'noopener' : undefined}
          class="btn btn-primary nav-btn"
        >
          {navCta.label}
        </a>
      </div>
    </nav>
  </div>

  <main>
    <div class="apply-wrap">
      <div class="form-card">

        <div class="trust-row">
          {avatars.length > 0 && (
            <div class="avatar-stack">
              {avatars.map((photo) => (
                <span class="mini-avatar">
                  <img src={urlFor(photo).width(64).height(64).url()} alt="" />
                </span>
              ))}
            </div>
          )}
          <div class="trust-copy">
            <div class="stars">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg width="14" height="14" viewBox="0 0 20 20" fill={i < fullStars ? 'var(--ink)' : 'none'} stroke="var(--ink)" stroke-width="1.3">
                  <path d="M10 1.5l2.6 5.5 6 .7-4.4 4.1 1.2 6-5.4-3-5.4 3 1.2-6L1.4 7.7l6-.7z" />
                </svg>
              ))}
            </div>
            <span>{rating} out of 5, {proofText}</span>
          </div>
        </div>

        <h1>Let's start the conversation.</h1>
        <p class="sub">This isn't a sales pitch with a deck. Answer a few quick questions and I'll follow up personally to see if a sprint is the right fit, no matter what you decide.</p>

        <form>
          <fieldset>
            <legend>Do you run or work for a B2B SaaS company? <span class="req">*</span></legend>
            <label class="option">
              <input type="radio" name="role" value="founder" />
              <span>Yes, I'm the founder / CEO</span>
            </label>
            <label class="option">
              <input type="radio" name="role" value="marketing-leader" />
              <span>Yes, I'm the marketing leader (CMO / Marketing Director)</span>
            </label>
            <label class="option">
              <input type="radio" name="role" value="marketing-team" />
              <span>Yes, I'm on the marketing team</span>
            </label>
            <label class="option">
              <input type="radio" name="role" value="other" />
              <span>Other</span>
            </label>
          </fieldset>

          <a
            href="https://wa.me/5016082944"
            target="_blank"
            rel="noopener"
            class="btn btn-primary next-btn"
          >
            Next
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </form>

        <p class="form-note">Placeholder form - a full intake form is coming soon. Tapping Next reaches Mickey directly on WhatsApp in the meantime.</p>
      </div>
    </div>
  </main>

  <footer>
    <span>{footerText}</span>
  </footer>
</body>
</html>

<style>
  :root {
    --ink: #0F0E0C;
    --ink-soft: #6B6558;
    --ink-faint: #A39C8C;
    --bg: #F7F5F0;
    --panel: #FFFFFF;
    --line: #E5E1D8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding-top: 72px;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    background: var(--bg);
  }
  a { color: inherit; text-decoration: none; }
  h1 { font-family: 'Lora', Georgia, serif; font-weight: 600; }

  .nav-bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(247, 245, 240, 0.82);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  nav {
    max-width: 1080px; margin: 0 auto; padding: 16px 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; }
  .nav-avatar {
    width: 32px; height: 32px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    background: var(--line); display: flex; align-items: center; justify-content: center;
    box-shadow: inset 0 0 0 2px var(--bg);
  }
  .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .links { display: flex; gap: 28px; font-size: 14px; color: var(--ink); }
  .links a:hover { opacity: 0.7; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; border-radius: 999px; font-weight: 600; font-size: 14px; border: none; cursor: pointer; font-family: inherit; }
  .btn-primary { background: var(--ink); color: var(--bg); }

  main { padding: 64px 24px 96px; }
  .apply-wrap { max-width: 640px; margin: 0 auto; }

  .form-card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 20px;
    padding: 40px clamp(24px, 5vw, 48px);
  }

  .trust-row { display: flex; align-items: center; gap: 14px; margin: 0 0 24px; flex-wrap: wrap; }
  .avatar-stack { display: flex; }
  .mini-avatar {
    width: 34px; height: 34px; border-radius: 50%; overflow: hidden; flex-shrink: 0;
    box-shadow: 0 0 0 2px var(--panel); margin-left: -10px; background: var(--line);
  }
  .mini-avatar:first-child { margin-left: 0; }
  .mini-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .trust-copy { display: flex; flex-direction: column; gap: 3px; }
  .stars { display: flex; gap: 2px; }
  .trust-copy span { font-size: 12.5px; color: var(--ink-soft); font-weight: 500; }

  h1 { font-size: clamp(24px, 3.2vw, 30px); line-height: 1.25; margin: 0 0 12px; letter-spacing: -0.01em; }
  p.sub { font-size: 15px; line-height: 1.6; color: var(--ink-soft); margin: 0 0 32px; }

  fieldset { border: none; padding: 0; margin: 0 0 24px; }
  legend { font-size: 14.5px; font-weight: 600; margin: 0 0 14px; padding: 0; }
  .req { color: var(--ink-faint); }
  .option {
    display: flex; align-items: center; gap: 12px;
    border: 1px solid var(--line); border-radius: 999px; padding: 14px 18px;
    margin-bottom: 10px; cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease;
  }
  .option:hover { border-color: var(--ink); }
  .option input { accent-color: var(--ink); width: 16px; height: 16px; flex-shrink: 0; }
  .option:has(input:checked) { border-color: var(--ink); background: var(--bg); }
  .option span { font-size: 14.5px; font-weight: 500; }

  .next-btn { width: 100%; justify-content: center; height: 50px; font-size: 15px; }
  .form-note { font-size: 12.5px; color: var(--ink-faint); text-align: center; margin: 18px 0 0; }

  footer {
    padding: 28px 24px; border-top: 1px solid var(--line);
    color: var(--ink-faint); font-size: 13px; text-align: center;
  }

  @media (max-width: 640px) {
    nav { flex-wrap: wrap; }
    .links { display: none; }
    .form-card { padding: 32px 20px; border-radius: 16px; }
  }
</style>
